{
  "name": "codex-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun --no-warnings .codex/workflow-mcp/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.workflow-mcp.json && tsc --noEmit -p tsconfig.agents.json",
    "test": "bun test --timeout=60000 ./.codex/workflow-mcp/tests/*.node.ts ./.codex/agents/tests/*.node.ts",
    "test:agents": "bun test --timeout=60000 ./.codex/agents/tests/*.node.ts",
    "test:workflow-mcp": "bun test --timeout=60000 ./.codex/workflow-mcp/tests/*.node.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
