{
  "name": "codex-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "export WORKFLOW_MCP_TRUSTED_PROVIDER_ROOT=\"$PWD\"; bootstrap=$(mktemp) && trap 'rm -f \"$bootstrap\"' EXIT && git show HEAD:.codex/workflow-mcp/bootstrap.ts >\"$bootstrap\" && bun --no-warnings \"$bootstrap\"; status=$?; exit \"$status\"",
    "generate:agents": "bun .codex/agents/generate-host-definitions.ts --write",
    "typecheck": "tsc -p tsconfig.workflow-mcp.json && tsc -p tsconfig.agents.json && tsc -p tsconfig.installer.json",
    "test": "bun test --parallel=7 --parallel-delay=0 --timeout=60000 ./.codex/workflow-mcp/tests/*.test.ts ./.codex/agents/tests/*.test.ts ./.codex/installer/tests/*.test.ts",
    "test:agents": "bun test --timeout=60000 ./.codex/agents/tests/*.test.ts",
    "test:installer": "bun test --timeout=60000 ./.codex/installer/tests/*.test.ts",
    "test:workflow-mcp": "bun test --parallel=7 --parallel-delay=0 --timeout=60000 ./.codex/workflow-mcp/tests/*.test.ts",
    "test:coverage": "bun test --parallel=7 --parallel-delay=0 --coverage --timeout=60000 ./.codex/workflow-mcp/tests/*.test.ts ./.codex/agents/tests/*.test.ts ./.codex/installer/tests/*.test.ts",
    "test:stress": "bun test --parallel=7 --parallel-delay=0 --randomize --rerun-each=2 --timeout=60000 ./.codex/workflow-mcp/tests/*.test.ts ./.codex/agents/tests/*.test.ts ./.codex/installer/tests/*.test.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "check": "biome check . --error-on-warnings",
    "validate": "bun run check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jsonc-parser": "^3.3.1",
    "simple-git": "3.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
