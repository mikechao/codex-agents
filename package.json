{
  "name": "codex-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun --no-warnings .codex/workflow-mcp/server.ts",
    "generate:agents": "bun .codex/agents/generate-host-definitions.ts --write",
    "typecheck": "tsc -p tsconfig.workflow-mcp.json && tsc -p tsconfig.agents.json && tsc -p tsconfig.installer.json",
    "test": "bun test --parallel=7 --parallel-delay=0 --timeout=60000 ./.codex/workflow-mcp/tests/*.node.ts ./.codex/agents/tests/*.node.ts ./.codex/installer/tests/*.node.ts",
    "test:agents": "bun test --timeout=60000 ./.codex/agents/tests/*.node.ts",
    "test:installer": "bun test --timeout=60000 ./.codex/installer/tests/*.node.ts",
    "test:workflow-mcp": "bun test --parallel=7 --parallel-delay=0 --timeout=60000 ./.codex/workflow-mcp/tests/*.node.ts",
    "test:coverage": "bun test --parallel=7 --parallel-delay=0 --coverage --timeout=60000 ./.codex/workflow-mcp/tests/*.node.ts ./.codex/agents/tests/*.node.ts ./.codex/installer/tests/*.node.ts",
    "test:stress": "bun test --parallel=7 --parallel-delay=0 --randomize --rerun-each=2 --timeout=60000 ./.codex/workflow-mcp/tests/*.node.ts ./.codex/agents/tests/*.node.ts ./.codex/installer/tests/*.node.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "check": "biome check . --error-on-warnings",
    "validate": "bun run check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13",
  "x-performance-evidence": {
    "issue": "#16",
    "captured_on": "2026-08-17",
    "machine": "Darwin M1-pro.local 25.5.0 arm64",
    "runtime": "Bun 1.3.13",
    "method": "Wall-clock seconds for one successful sequential `bun run <script>` invocation per command; stdout and stderr were suppressed by the timing harness.",
    "commands": [
      "bun run test",
      "bun run test:coverage",
      "bun run test:stress",
      "bun run test:workflow-mcp",
      "bun run validate"
    ],
