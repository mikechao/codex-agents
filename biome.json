{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      ".codex/**/*.ts",
      "install-into.ts",
      "package.json",
      "opencode.json",
      ".codex/planner-policy.json",
      "tsconfig*.json",
      "biome.json"
    ],
    "ignoreUnknown": true
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noTemplateCurlyInString": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "noAdjacentSpacesInRegex": "off"
          }
        }
      }
    },
    {
      "includes": [".codex/workflow-mcp/store.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
